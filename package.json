{
  "name": "vesta",
  "version": "0.1.0",
  "private": true,
  "description": "Vesta: summaries, rankings and plain-language fire-safety insights from NASA's microgravity fire experiments. NASA Space Apps Challenge 2026.",
  "scripts": {
    "dev": "bun --bun next dev",
    "dev:ai": "bun scripts/dev-ai.ts",
    "dev:api": "bun scripts/dev-functions.ts",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "typecheck": "tsc --noEmit",
    "build:passages": "bun scripts/build-passages.ts",
    "save-answers": "bun scripts/save-answers.ts"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6"
  }
}
